["“Someone is repairing the road now.” →",["The road is repaired now.","The road is being repaired now.","The road was being repaired now.","The road has repaired now."],1,"“Now” shows a present continuous action: is being repaired."],
["Which sentence uses the passive correctly for a general truth?",["Rice is grown in Bangladesh.","Rice is grow in Bangladesh.","Rice are grown in Bangladesh.","Rice is growing by farmers in Bangladesh every year yesterday."],0,"“Is grown” is the correct present simple passive for a general fact."],
["“The chef tastes the soup.” → Passive:",["The soup is tasted by the chef.","The soup tastes by the chef.","The soup is taste by the chef.","The soup was tasting by the chef."],0,"Present simple: object + is + past participle (tasted)."],
["“Did the manager invite you?” → Passive:",["Were you invited by the manager?","Was you invited by the manager?","Did you invited by the manager?","Are you invite by the manager?"],0,"Past simple questions in passive begin with Was/Were + subject + past participle."],
["“The company will launch a new phone next month.” →",["A new phone will be launched next month.","A new phone will launched next month.","A new phone is launch next month.","A new phone will being launched next month."],0,"Will + be + past participle forms the future passive."]
