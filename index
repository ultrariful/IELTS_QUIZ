<!doctype html>
<html lang="bn">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="color-scheme" content="dark" />
<link rel="icon" href="data:," />
<title>IELTS Quiz Arena — Road to Band 8</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+Bengali:wght@400;600;700;800&display=swap" rel="stylesheet" />
<style>
:root{
  --bg:#0a1120; --bg2:#0e1830; --card:#121f3d; --card2:#16264a; --line:#24365e;
  --ink:#eef2fb; --muted:#a9b7d4; --gold:#d4af6a; --teal:#2bb896; --orange:#f59e0b;
  --green:#34c759; --red:#ef4456; --radius:16px;
  color-scheme:dark;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Noto Serif Bengali",serif;line-height:1.55;-webkit-tap-highlight-color:transparent}
button,[role="button"],select,input:not([type="checkbox"]){min-height:2.25rem;font-family:inherit}
button{cursor:pointer}
h1,h2,h3{line-height:1.25;margin:0}
p{margin:0}
.wrap{max-width:1080px;margin:0 auto;padding:0 16px 64px}
/* ---------- HERO ---------- */
.hero{position:relative;overflow:hidden;border-radius:0 0 28px 28px;padding:44px 16px 30px;text-align:center;
  background:linear-gradient(120deg,#0a1120,#13224a,#0d3b34,#3a2a10,#0a1120);background-size:300% 300%;animation:heroShift 16s ease infinite}
@keyframes heroShift{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
.hero h1{font-size:clamp(30px,6vw,52px);font-weight:800;letter-spacing:.5px}
.hero h1 .gold{color:var(--gold)}
.hero .sub{color:var(--muted);font-size:clamp(14px,2.6vw,18px);margin-top:8px}
.hero-stats{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-top:22px}
.hstat{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);border-radius:999px;padding:8px 16px;font-size:14px;min-height:36px;display:flex;align-items:center;gap:6px}
.hstat b{color:var(--gold);font-size:16px}
.float-emoji{position:absolute;font-size:26px;opacity:.85;animation:floaty 5s ease-in-out infinite;pointer-events:none}
@keyframes floaty{0%,100%{transform:translateY(0) rotate(-4deg)}50%{transform:translateY(-14px) rotate(5deg)}}
/* ---------- DASHBOARD ---------- */
.dash{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-top:22px}
.dcard{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:16px;text-align:center;transition:transform .25s,border-color .25s}
.dcard:hover{transform:translateY(-4px);border-color:var(--gold)}
.dcard .big{font-size:28px;font-weight:800;color:var(--gold)}
.dcard .lbl{color:var(--muted);font-size:13.5px;margin-top:2px}
.xpbar{height:9px;background:#0a1120;border-radius:99px;margin-top:10px;overflow:hidden}
.xpbar i{display:block;height:100%;background:linear-gradient(90deg,var(--teal),var(--gold));border-radius:99px;transition:width .6s}
/* ---------- SECTIONS ---------- */
section{margin-top:34px}
.sec-head{display:flex;align-items:center;gap:10px;margin-bottom:14px;flex-wrap:wrap}
.sec-head h2{font-size:clamp(20px,4vw,26px);font-weight:700}
.sec-head .hint{color:var(--muted);font-size:13.5px}
/* ---------- SEARCH & FILTERS ---------- */
.searchrow{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.searchbox{flex:1;min-width:220px;display:flex;align-items:center;gap:8px;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:0 14px}
.searchbox input{flex:1;background:none;border:none;color:var(--ink);font-size:16px;padding:10px 0;outline:none;font-family:inherit}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.chip{background:var(--card);color:var(--muted);border:1px solid var(--line);border-radius:999px;padding:8px 16px;font-size:14px;min-height:38px;transition:all .2s}
.chip:hover{border-color:var(--gold);color:var(--ink)}
.chip.on{background:var(--gold);color:#14100a;border-color:var(--gold);font-weight:700}
.chip.teal.on{background:var(--teal);border-color:var(--teal);color:#06231b}
/* ---------- CARDS GRID ---------- */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:14px}
.qcard{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:18px;display:flex;flex-direction:column;gap:8px;transition:transform .25s,border-color .25s,box-shadow .25s;text-align:left;color:var(--ink);width:100%}
.qcard:hover{transform:translateY(-5px);border-color:var(--gold);box-shadow:0 14px 30px rgba(0,0,0,.35)}
.qcard .ic{font-size:30px}
.qcard h3{font-size:17.5px;font-weight:700}
.qcard .meta{color:var(--muted);font-size:13px;display:flex;gap:8px;flex-wrap:wrap}
.tag{border:1px solid var(--line);border-radius:999px;padding:2px 10px;font-size:12px;color:var(--muted)}
.tag.lv{color:var(--teal);border-color:var(--teal)}
.tag.ct{color:var(--gold);border-color:var(--gold)}
.qcard .best{color:var(--gold);font-size:13.5px;font-weight:700}
.qcard .go{margin-top:auto;color:var(--orange);font-weight:700;font-size:14.5px}
.qcard.special{background:linear-gradient(160deg,var(--card2),var(--card));border-color:#31487e}
.qcard.special .go{color:var(--teal)}
.empty-note{color:var(--muted);text-align:center;padding:26px;border:1px dashed var(--line);border-radius:var(--radius);grid-column:1/-1}
/* ---------- HOW IT WORKS ---------- */
.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}
.step{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:18px;text-align:center}
.step .em{font-size:34px}
.step h3{margin:8px 0 4px;font-size:16.5px}
.step p{color:var(--muted);font-size:14px}
/* ---------- BADGES ---------- */
.badges{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px}
.badge{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:14px;text-align:center;opacity:.45;filter:grayscale(.7)}
.badge.got{opacity:1;filter:none;border-color:var(--gold)}
.badge .em{font-size:30px}
.badge h3{font-size:14.5px;margin-top:6px}
.badge p{color:var(--muted);font-size:12.5px}
/* ---------- BUTTONS ---------- */
.btn{background:var(--gold);color:#171106;border:none;border-radius:12px;padding:11px 22px;font-size:15.5px;font-weight:700;min-height:44px;transition:transform .2s,filter .2s}
.btn:hover{filter:brightness(1.08);transform:translateY(-2px)}
.btn.teal{background:var(--teal);color:#05231b}
.btn.orange{background:var(--orange);color:#241300}
.btn.ghost{background:transparent;color:var(--ink);border:1px solid var(--line)}
.btn.ghost:hover{border-color:var(--gold)}
.btn.danger{background:transparent;color:var(--red);border:1px solid var(--red)}
.btn:disabled{opacity:.5;cursor:not-allowed;transform:none}
.btnrow{display:flex;gap:10px;flex-wrap:wrap}
/* ---------- VIEWS ---------- */
.view{display:none}
.view.on{display:block;animation:fadeIn .35s ease}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.panel{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:22px;max-width:760px;margin:26px auto 0}
.panel h2{font-size:clamp(20px,4.5vw,27px);font-weight:800}
.backlink{background:none;border:none;color:var(--muted);font-size:15px;padding:10px 4px;min-height:44px}
.backlink:hover{color:var(--gold)}
.opt-group{margin-top:18px}
.opt-group h3{font-size:15px;color:var(--muted);margin-bottom:8px;font-weight:600}
.seg{display:flex;gap:8px;flex-wrap:wrap}
.seg button{background:var(--bg2);color:var(--ink);border:1px solid var(--line);border-radius:10px;padding:10px 18px;font-size:15px;min-height:44px}
.seg button.on{background:var(--gold);color:#171106;border-color:var(--gold);font-weight:700}
.switchrow{display:flex;align-items:center;gap:12px;margin-top:16px;font-size:15px}
.switch{position:relative;width:52px;height:30px;flex:none}
.switch input{opacity:0;width:100%;height:100%;position:absolute;margin:0;cursor:pointer}
.switch .tr{position:absolute;inset:0;background:#2a3a5f;border-radius:99px;transition:.25s;pointer-events:none}
.switch .tr::after{content:"";position:absolute;top:3px;left:3px;width:24px;height:24px;border-radius:50%;background:#fff;transition:.25s}
.switch input:checked + .tr{background:var(--teal)}
.switch input:checked + .tr::after{left:25px}
/* ---------- QUIZ ---------- */
.qtop{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
.qcount{font-weight:700;font-size:16px}
.qtimer{font-weight:800;color:var(--orange);font-size:16px}
.segbar{display:flex;gap:3px;margin:14px 0 4px}
.segbar i{flex:1;height:9px;border-radius:99px;background:#2a3a5f;transition:background .3s}
.segbar i.ok{background:var(--green)}
.segbar i.bad{background:var(--red)}
.segbar i.cur{background:var(--gold)}
.timebar{height:8px;background:#2a3a5f;border-radius:99px;overflow:hidden;margin-top:10px}
.timebar i{display:block;height:100%;background:var(--orange);transition:width 1s linear}
.qtext{font-size:clamp(17px,3.4vw,20px);font-weight:600;margin:18px 0 16px;line-height:1.6}
.opts{display:grid;gap:10px}
.opt{display:flex;gap:12px;align-items:flex-start;text-align:left;background:var(--bg2);border:2px solid var(--line);border-radius:14px;padding:14px 16px;font-size:16px;color:var(--ink);min-height:52px;width:100%;transition:border-color .2s,background .2s,transform .15s}
.opt:hover:not(:disabled){border-color:var(--gold);transform:translateX(3px)}
.opt .key{flex:none;width:26px;height:26px;border-radius:8px;background:#22335c;color:var(--gold);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:13.5px}
.opt.correct{background:rgba(52,199,89,.14);border-color:var(--green)}
.opt.correct .key{background:var(--green);color:#06280f}
.opt.wrong{background:rgba(239,68,86,.13);border-color:var(--red)}
.opt.wrong .key{background:var(--red);color:#2b060b}
.opt:disabled{cursor:default;opacity:.92}
.explain{display:none;margin-top:16px;background:rgba(43,184,150,.1);border:1px solid var(--teal);border-radius:14px;padding:14px 16px;font-size:15px}
.explain.show{display:block;animation:fadeIn .3s}
.explain b{color:var(--teal)}
.typein{width:100%;background:var(--bg2);border:2px solid var(--line);border-radius:12px;color:var(--ink);font-size:17px;padding:13px 16px;font-family:inherit;outline:none}
.typein:focus{border-color:var(--gold)}
.typein.correct{border-color:var(--green);background:rgba(52,199,89,.12)}
.typein.wrong{border-color:var(--red);background:rgba(239,68,86,.12)}
.quizfoot{display:flex;justify-content:space-between;gap:10px;margin-top:20px;flex-wrap:wrap}
/* ---------- RESULTS ---------- */
.scorebig{font-size:clamp(44px,10vw,64px);font-weight:800;text-align:center;color:var(--gold)}
.resultmsg{text-align:center;color:var(--muted);font-size:16.5px;margin-top:4px}
.xpgain{text-align:center;color:var(--teal);font-weight:800;font-size:19px;margin-top:8px}
.bandbox{text-align:center;background:rgba(212,175,106,.1);border:1px solid var(--gold);border-radius:14px;padding:14px;margin-top:16px}
.bandbox .b{font-size:30px;font-weight:800;color:var(--gold)}
.review{margin-top:22px;display:grid;gap:12px}
.ritem{background:var(--bg2);border:1px solid var(--line);border-radius:14px;padding:14px 16px;font-size:14.5px}
.ritem .rq{font-weight:700;font-size:15.5px}
.ritem .ok{color:var(--green)} .ritem .bad{color:var(--red)}
.ritem .re{color:var(--muted);margin-top:4px}
/* ---------- FLASHCARDS ---------- */
.flashwrap{perspective:1200px;max-width:560px;margin:20px auto 0}
.flash{position:relative;height:300px;transform-style:preserve-3d;transition:transform .6s;cursor:pointer}
.flash.flip{transform:rotateY(180deg)}
.face{position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;border-radius:20px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px;text-align:center;border:2px solid var(--line)}
.face.front{background:linear-gradient(150deg,var(--card2),var(--card))}
.face.back{background:linear-gradient(150deg,#0d3b34,var(--card));transform:rotateY(180deg);border-color:var(--teal)}
.face .fw{font-size:clamp(24px,5vw,34px);font-weight:800;color:var(--gold)}
.face .fm{font-size:18px;font-weight:700;color:var(--teal)}
.face .fe{color:var(--muted);font-size:15px;margin-top:10px;font-style:italic}
.face .tap{color:var(--muted);font-size:13px;margin-top:14px}
.deckbar{height:10px;background:#2a3a5f;border-radius:99px;overflow:hidden;max-width:560px;margin:16px auto 0}
.deckbar i{display:block;height:100%;background:var(--teal);transition:width .4s}
/* ---------- PASSAGE / SPEAKING ---------- */
.passage{background:var(--bg2);border:1px solid var(--line);border-radius:14px;padding:18px;font-size:16px;line-height:1.75;margin-top:14px}
.tfng{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
.tfng button{flex:1;min-width:90px;background:var(--bg2);border:2px solid var(--line);color:var(--ink);border-radius:10px;padding:10px;font-size:15px;min-height:46px}
.tfng button.on{border-color:var(--gold);background:rgba(212,175,106,.12);font-weight:700}
.promptcard{background:var(--bg2);border:1px solid var(--line);border-radius:14px;padding:16px 18px;margin-top:12px}
.promptcard .pq{font-size:16.5px;font-weight:600}
.promptcard ul{margin:8px 0 0;padding-left:20px;color:var(--muted);font-size:14.5px}
.stars{display:flex;gap:4px;margin-top:10px}
.stars button{background:none;border:none;font-size:26px;padding:4px;min-height:40px;min-width:40px;filter:grayscale(1);opacity:.5}
.stars button.lit{filter:none;opacity:1}
.bigtime{font-size:clamp(40px,9vw,58px);font-weight:800;text-align:center;color:var(--orange)}
/* ---------- MODAL / TOAST ---------- */
.modal-bg{position:fixed;inset:0;background:rgba(3,6,14,.78);display:none;align-items:center;justify-content:center;padding:16px;z-index:60}
.modal-bg.on{display:flex}
.modal{background:var(--card);border:1px solid var(--gold);border-radius:20px;max-width:560px;width:100%;max-height:88vh;overflow:auto;padding:24px}
.modal h2{font-size:21px;margin-bottom:10px}
.modal ol{padding-left:22px;color:var(--muted);font-size:15px;display:grid;gap:7px}
.modal code{background:#0a1120;border:1px solid var(--line);border-radius:6px;padding:1px 7px;color:var(--gold);font-family:inherit;font-size:13.5px}
#toast{position:fixed;left:50%;bottom:26px;transform:translate(-50%,120px);background:var(--card2);border:1px solid var(--gold);color:var(--ink);border-radius:14px;padding:13px 20px;font-size:15.5px;font-weight:700;z-index:80;transition:transform .45s;box-shadow:0 16px 40px rgba(0,0,0,.5);max-width:92vw;text-align:center}
#toast.on{transform:translate(-50%,0)}
#confetti{position:fixed;inset:0;pointer-events:none;z-index:70;display:none}
footer{margin-top:48px;text-align:center;color:var(--muted);font-size:14px;border-top:1px solid var(--line);padding-top:22px}
footer b{color:var(--gold)}
.backup-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
@media (max-width:560px){ .float-emoji{display:none} }
@media (prefers-reduced-motion: reduce){
  *,*::before,*::after{animation-duration:.01ms !important;animation-iteration-count:1 !important;transition-duration:.01ms !important}
  html{scroll-behavior:auto}
}
</style>
</head>
<body>

<!-- ================= HOME ================= -->
<div id="view-home" class="view on">
  <div class="hero">
    <span class="float-emoji" style="top:16px;left:6%">📚</span>
    <span class="float-emoji" style="top:54px;right:7%;animation-delay:1.2s">✈️</span>
    <span class="float-emoji" style="bottom:18px;left:12%;animation-delay:2s">🏆</span>
    <span class="float-emoji" style="bottom:26px;right:11%;animation-delay:.6s">💬</span>
    <h1>IELTS Quiz <span class="gold">Arena</span> 🎯</h1>
    <p class="sub">Road to Band 8 — Grammar • Vocabulary • Reading • Writing • Speaking</p>
    <div class="hero-stats">
      <span class="hstat">📝 মোট প্রশ্ন <b id="hs-total">290</b></span>
      <span class="hstat">🗂️ কুইজ <b>16</b></span>
      <span class="hstat">⭐ XP <b id="hs-xp">0</b></span>
      <span class="hstat">🔥 স্ট্রিক <b id="hs-streak">0</b> দিন</span>
      <span class="hstat">🎯 Accuracy <b id="hs-acc">—</b></span>
    </div>
  </div>

  <div class="wrap">
    <!-- Dashboard -->
    <div class="dash" id="dash"></div>

    <!-- Special modes -->
    <section>
      <div class="sec-head"><h2>⚡ স্পেশাল প্র্যাক্টিস মোড</h2><span class="hint">প্রতিদিনের চ্যালেঞ্জ, মক টেস্ট আর স্পিড গেম</span></div>
      <div class="grid" id="special-grid"></div>
    </section>

    <!-- Quiz bank -->
    <section>
      <div class="sec-head"><h2>🗂️ কুইজ ব্যাংক</h2><span class="hint">16টি কুইজ • 240টি MCQ • প্রতিটি প্রশ্নে ব্যাখ্যা</span></div>
      <div class="searchrow">
        <label class="searchbox">🔍 <input id="search" type="search" placeholder="কুইজ খুঁজুন — যেমন: Tenses, Collocations, Passive…" aria-label="কুইজ খুঁজুন" /></label>
        <button class="btn ghost" id="btn-github" type="button">🚀 GitHub-এ পাবলিশ করুন</button>
      </div>
      <div class="chips" id="cat-chips" role="group" aria-label="ক্যাটাগরি ফিল্টার"></div>
      <div class="chips" id="lvl-chips" role="group" aria-label="লেভেল ফিল্টার"></div>
      <div class="grid" id="quiz-grid" style="margin-top:14px"></div>
    </section>

    <!-- How it works -->
    <section>
      <div class="sec-head"><h2>🧭 কীভাবে কাজ করে</h2></div>
      <div class="steps">
        <div class="step"><div class="em">1️⃣</div><h3>কুইজ বেছে নিন</h3><p>16টি টপিক থেকে যেকোনো একটি সিলেক্ট করুন, প্রশ্নের সংখ্যা আর মোড (Practice / Timed) ঠিক করে Start চাপুন।</p></div>
        <div class="step"><div class="em">2️⃣</div><h3>উত্তর দিন, ব্যাখ্যা পড়ুন</h3><p>প্রতিটি প্রশ্নের পরেই সঠিক উত্তর আর সহজ ব্যাখ্যা পাবেন। ভুলগুলো My Mistakes-এ জমা হবে পরে প্র্যাক্টিসের জন্য।</p></div>
        <div class="step"><div class="em">3️⃣</div><h3>XP আর ব্যাজ জিতুন</h3><p>সঠিক উত্তরে XP, 80%+ স্কোরে বোনাস আর কনফেটি! স্ট্রিক ধরে রাখুন, ব্যাজ আনলক করুন, Band 8-এর দিকে এগিয়ে যান।</p></div>
      </div>
    </section>

    <!-- Badges -->
    <section>
      <div class="sec-head"><h2>🏆 আমার ব্যাজ</h2><span class="hint" id="badge-count"></span></div>
      <div class="badges" id="badge-grid"></div>
    </section>

    <!-- Backup -->
    <section>
      <div class="sec-head"><h2>💾 ব্যাকআপ ও রিস্টোর</h2><span class="hint">সব প্রোগ্রেস এই ব্রাউজারেই সেভ থাকে</span></div>
