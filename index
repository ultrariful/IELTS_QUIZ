var S = (function(){ try{ var raw=localStorage.getItem(LS_KEY); if(raw){ var p=JSON.parse(raw); var f=freshState(); for(var k in f){ if(p[k]===undefined) p[k]=f[k]; } return p; } }catch(e){} return freshState(); })();
