/* day streak — counts only days on which at least one question was answered */
function yesterdayStr(){ var y=new Date(); y.setDate(y.getDate()-1); return y.getFullYear()+"-"+String(y.getMonth()+1).padStart(2,"0")+"-"+String(y.getDate()).padStart(2,"0"); }
function displayStreak(){ if(!S.lastAnswerDay) return 0; if(S.lastAnswerDay===todayStr() || S.lastAnswerDay===yesterdayStr()) return S.streakCount||0; return 0; }
function touchStreak(){ var t=todayStr(); if(S.lastAnswerDay!==t){ S.streakCount = (S.lastAnswerDay===yesterdayStr()) ? (S.streakCount||0)+1 : 1; S.lastAnswerDay=t; } }

