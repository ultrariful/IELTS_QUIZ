function buildChips(el, list, cur, cb){
 el.innerHTML = list.map(function(x){ return '<button type="button" class="chip'+(x===cur?" on":"")+'" data-v="'+x+'">'+(x==="All"?"সব":x)+'</button>'; }).join("");
 Array.prototype.forEach.call(el.querySelectorAll(".chip"), function(ch){ ch.addEventListener("click", function(){ cb(ch.getAttribute("data-v")); }); });
}
function renderChips(){
 buildChips($("#cat-chips"), CAT_CHIPS, curCat, function(v){ curCat=v; renderChips(); applyFilters(); });
 buildChips($("#lvl-chips"), LVL_CHIPS, curLvl, function(v){ curLvl=v; renderChips(); applyFilters(); });
}
$("#search").addEventListener("input", function(e){ curSearch=e.target.value.trim().toLowerCase(); applyFilters(); });

/* ---------- question preparation ---------- */
function prepareItem(quiz, qi, doShuffle){
 var raw = quiz.questions[qi];
 if(raw && raw.t===1){ return { quizId:quiz.id, qi:qi, type:"text", q:raw.q, accept:raw.a, exp:raw.e, cat:quiz.cat, lvl:quiz.level, title:quiz.title }; }
 var order=[0,1,2,3]; if(doShuffle) order=shuffleArr(order);
 var opts=order.map(function(i){ return raw[1][i]; });
 return { quizId:quiz.id, qi:qi, type:"mcq", q:raw[0], opts:opts, ans:order.indexOf(raw[2]), correctText:raw[1][raw[2]], exp:raw[3], cat:quiz.cat, lvl:quiz.level, title:quiz.title };
}
function allItems(doShuffle){
 var pool=[]; QUIZZES.forEach(function(q){ q.questions.forEach(function(_,i){ pool.push(prepareItem(q,i,doShuffle)); }); }); return pool;
}

/* ---------- setup ---------- */
var setupQuiz=null, setupCount=15, setupMode="practice", setupShuffle=true;
function openSetup(id){
 setupQuiz=quizById(id); if(!setupQuiz) return;
 $("#setup-icon").textContent=setupQuiz.icon;
 $("#setup-title").textContent=setupQuiz.title;
 $("#setup-meta").textContent=setupQuiz.cat+" • "+setupQuiz.level+" • মোট "+setupQuiz.questions.length+"টি প্রশ্ন (প্রতিটিতে ব্যাখ্যা)";
 $("#setup-best").textContent= S.best[id] ? "🏆 আপনার সেরা স্কোর: "+S.best[id] : "";
 var hasResume = S.resume && S.resume.quizId===id;
 $("#btn-resume").style.display = hasResume? "" : "none";
 showView("setup");
}
function segWire(id, cb){
 Array.prototype.forEach.call(document.querySelectorAll("#"+id+" button"), function(b){
  b.addEventListener("click", function(){ Array.prototype.forEach.call(document.querySelectorAll("#"+id+" button"), function(x){ x.classList.remove("on"); }); b.classList.add("on"); cb(b.getAttribute("data-v")); });
 });
}
segWire("setup-count", function(v){ setupCount = v==="all" ? "all" : parseInt(v,10); });
segWire("setup-mode", function(v){ setupMode=v; });
$("#setup-shuffle").addEventListener("change", function(e){ setupShuffle=e.target.checked; });
$("#btn-start").addEventListener("click", function(){
 if(!setupQuiz) return;
 var idxs = setupQuiz.questions.map(function(_,i){ return i; });
 if(setupShuffle) idxs=shuffleArr(idxs);
 var n = setupCount==="all" ? idxs.length : Math.min(setupCount, idxs.length);
 var items = idxs.slice(0,n).map(function(i){ return prepareItem(setupQuiz,i,setupShuffle); });
 if(S.resume && S.resume.quizId===setupQuiz.id){ S.resume=null; save(); }
 startSession({ kind:"quiz", quizId:setupQuiz.id, title:setupQuiz.title, items:items, mode:setupMode });
});
$("#btn-resume").addEventListener("click", function(){
 if(S.resume && setupQuiz && S.resume.quizId===setupQuiz.id){
   var r=S.resume; startSession({ kind:"quiz", quizId:r.quizId, title:quizById(r.quizId).title, items:r.items, mode:r.mode, idx:r.idx, results:r.results });
 }
});

/* ---------- quiz engine ---------- */
var SES=null, qTimerInt=null, qAutoTo=null, blitzInt=null;
function stopAllTimers(){ if(qTimerInt){ clearInterval(qTimerInt); qTimerInt=null; } if(qAutoTo){ clearTimeout(qAutoTo); qAutoTo=null; } if(blitzInt){ clearInterval(blitzInt); blitzInt=null; } if(spInt){ clearInterval(spInt); spInt=null; } if(typeof examInt!=="undefined" && examInt){ clearInterval(examInt); examInt=null; } }

function startSession(cfg){
 stopAllTimers(); examSec=0;
 SES={ kind:cfg.kind, quizId:cfg.quizId||null, title:cfg.title, items:cfg.items, mode:cfg.mode||"practice",
       idx:cfg.idx||0, results:cfg.results||[], answered:false, startAt:Date.now(),
       combo:0, bestCombo:0, xp:0, blitzLeft:60, clearedNow:0 };
 showView("quiz");
 if(SES.kind==="blitz"){ startBlitzClock(); }
 renderQuestion();
}
function startBlitzClock(){
 $("#q-timebar").style.display="block";
 blitzInt=setInterval(function(){
   SES.blitzLeft--;
   $("#q-timer").textContent="⚡ "+SES.blitzLeft+"s";
   $("#q-timefill").style.width=(SES.blitzLeft/60*100)+"%";
   if(SES.blitzLeft<=0){ finishSession(); }
 },1000);
 $("#q-timer").textContent="⚡ 60s";
}
function segbarRender(){
 var bar=$("#q-segbar");
 if(SES.kind==="blitz"){ bar.innerHTML = SES.results.map(function(r){ return '<i class="'+(r.ok?"ok":"bad")+'"></i>'; }).join("") || '<i></i>'; return; }
 bar.innerHTML = SES.items.map(function(_,i){
   var cls=""; if(SES.results[i]) cls=SES.results[i].ok?"ok":"bad"; else if(i===SES.idx) cls="cur";
   return '<i class="'+cls+'"></i>';
 }).join("");
}
function renderQuestion(){
 if(!SES) return;
 if(SES.idx>=SES.items.length){ finishSession(); return; }
 SES.answered=false;
 var it=SES.items[SES.idx];
 segbarRender();
 $("#q-count").textContent = SES.kind==="blitz" ? ("সঠিক: "+SES.results.filter(function(r){return r.ok;}).length+" • চেষ্টা: "+SES.results.length) : ("Question "+(SES.idx+1)+" of "+SES.items.length);
 $("#q-cat").textContent = it.title+" • "+it.cat;
 $("#q-lvl").textContent = it.lvl;
 $("#q-text").textContent = it.q;
 $("#q-combo").textContent = (SES.kind==="blitz" && SES.combo>=2) ? ("🔥 Combo x"+(SES.combo>=3?2:1)+" • টানা "+SES.combo+"টি সঠিক") : "";
 $("#q-explain").className="explain"; $("#q-explain").innerHTML="";
 $("#btn-next").style.display="none";
 var optsBox=$("#q-opts"), typeWrap=$("#q-typewrap");
 if(it.type==="text"){
   optsBox.innerHTML=""; optsBox.style.display="none"; typeWrap.style.display="block";
   var inp=$("#q-typein"); inp.value=""; inp.className="typein"; inp.disabled=false;
   $("#btn-check-type").disabled=false;
   setTimeout(function(){ try{ inp.focus(); }catch(e){} },60);
 } else {
   typeWrap.style.display="none"; optsBox.style.display="grid";
   optsBox.innerHTML = it.opts.map(function(o,i){
     return '<button type="button" class="opt" data-i="'+i+'"><span class="key">'+(i+1)+'</span><span>'+escapeHtml(o)+'</span></button>';
   }).join("");
   Array.prototype.forEach.call(optsBox.querySelectorAll(".opt"), function(b){
     b.addEventListener("click", function(){ answerMCQ(parseInt(b.getAttribute("data-i"),10)); });
   });
 }
 if(SES.mode==="timed" && SES.kind!=="blitz"){ startPerQTimer(); }
 else if(SES.kind!=="blitz"){ $("#q-timebar").style.display="none"; $("#q-timer").textContent = SES.mode==="exam" ? ("⏱ মোট সময়: 0:00") : ""; if(SES.mode==="exam") startExamClock(); }
}
function escapeHtml(s){ return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;"); }
var examInt=null, examSec=0;
function startExamClock(){
 if(examInt) return;
 examInt=setInterval(function(){ if(!SES){ clearInterval(examInt); examInt=null; return; } examSec++; $("#q-timer").textContent="⏱ মোট সময়: "+Math.floor(examSec/60)+":"+String(examSec%60).padStart(2,"0"); },1000);
}
function startPerQTimer(){
 $("#q-timebar").style.display="block";
 var left=30; $("#q-timer").textContent="⏱ "+left+"s"; $("#q-timefill").style.width="100%";
 if(qTimerInt) clearInterval(qTimerInt);
 qTimerInt=setInterval(function(){
   left-=0.25;
   if(left<=0){ clearInterval(qTimerInt); qTimerInt=null; $("#q-timer").textContent="⏱ 0s"; $("#q-timefill").style.width="0%"; onTimeout(); return; }
   $("#q-timer").textContent="⏱ "+Math.ceil(left)+"s"; $("#q-timefill").style.width=(left/30*100)+"%";
 },250);
}
function recordResult(ok, chosenText, correctText){
 var it=SES.items[SES.idx];
 SES.results[SES.idx]={ ok:ok, chosen:chosenText, correct:correctText, q:it.q, exp:it.exp };
 S.answered++; if(ok) S.correct++; touchStreak();
 if(SES.kind==="blitz"){
   if(ok){ SES.combo++; SES.bestCombo=Math.max(SES.bestCombo,SES.combo); SES.xp += SES.combo>=3?20:10; }
   else SES.combo=0;
 }
 if(!ok && it.quizId){
   var key=it.quizId+"#"+it.qi;
   if(SES.kind==="mistakes"){ if(S.mistakes[key]) S.mistakes[key].s=0; }
   else if(!S.mistakes[key]) S.mistakes[key]={s:0};
 }
 if(ok && SES.kind==="mistakes" && it.quizId){
   var k2=it.quizId+"#"+it.qi;
   if(S.mistakes[k2]){ S.mistakes[k2].s++; if(S.mistakes[k2].s>=2){ delete S.mistakes[k2]; SES.clearedNow++; toast("🧹 একটি ভুল শুধরে ফেললেন! টানা 2 বার সঠিক ✓"); } }
 }
 save();
}
function revealMCQ(chosenIdx){
 var it=SES.items[SES.idx];
 Array.prototype.forEach.call($("#q-opts").querySelectorAll(".opt"), function(b){
   var i=parseInt(b.getAttribute("data-i"),10); b.disabled=true;
   if(i===it.ans) b.classList.add("correct");
   else if(i===chosenIdx) b.classList.add("wrong");
 });
}
function showExplain(html){ var e=$("#q-explain"); e.innerHTML=html; e.classList.add("show"); }
function answerMCQ(i){
 if(!SES || SES.answered) return;
 var it=SES.items[SES.idx]; if(it.type!=="mcq") return;
 SES.answered=true;
 if(qTimerInt){ clearInterval(qTimerInt); qTimerInt=null; }
 var ok = i===it.ans;
 recordResult(ok, it.opts[i], it.correctText);
 revealMCQ(i);
 if(SES.kind==="blitz"){ setTimeout(nextQuestion, 350); return; }
 if(SES.mode==="exam"){ setTimeout(nextQuestion, 250); return; }
 showExplain((ok?"✅ <b>সঠিক!</b> ":"❌ <b>ভুল।</b> সঠিক উত্তর: <b>"+escapeHtml(it.correctText)+"</b><br>")+"💡 "+escapeHtml(it.exp));
 $("#btn-next").style.display=""; $("#btn-next").textContent = SES.idx>=SES.items.length-1 ? "ফলাফল দেখুন ✓" : "Next →";
 segbarRender();
}
function answerText(){
 if(!SES || SES.answered) return;
 var it=SES.items[SES.idx]; if(it.type!=="text") return;
 var val=$("#q-typein").value.trim().toLowerCase();
 if(!val){ toast("✍️ আগে উত্তর টাইপ করুন"); return; }
 SES.answered=true;
 if(qTimerInt){ clearInterval(qTimerInt); qTimerInt=null; }
 var ok = it.accept.some(function(a){ return a.toLowerCase()===val; });
 recordResult(ok, $("#q-typein").value.trim(), it.accept[0]);
 var inp=$("#q-typein"); inp.disabled=true; inp.classList.add(ok?"correct":"wrong");
 $("#btn-check-type").disabled=true;
 if(SES.mode==="exam"){ setTimeout(nextQuestion, 250); return; }
 showExplain((ok?"✅ <b>সঠিক!</b> ":"❌ <b>ভুল।</b> সঠিক উত্তর: <b>"+escapeHtml(it.accept[0])+"</b><br>")+"💡 "+escapeHtml(it.exp));
 $("#btn-next").style.display=""; $("#btn-next").textContent = SES.idx>=SES.items.length-1 ? "ফলাফল দেখুন ✓" : "Next →";
 segbarRender();
}
function onTimeout(){
 if(!SES || SES.answered) return;
 var it=SES.items[SES.idx]; SES.answered=true;
 if(it.type==="mcq"){ recordResult(false,"(সময় শেষ)",it.correctText); revealMCQ(-1); }
 else { recordResult(false,"(সময় শেষ)",it.accept[0]); $("#q-typein").disabled=true; $("#btn-check-type").disabled=true; }
 showExplain("⏰ <b>সময় শেষ!</b> সঠিক উত্তর: <b>"+escapeHtml(it.type==="mcq"?it.correctText:it.accept[0])+"</b><br>💡 "+escapeHtml(it.exp));
 segbarRender();
 qAutoTo=setTimeout(nextQuestion, 2200);
}
function nextQuestion(){
 if(qAutoTo){ clearTimeout(qAutoTo); qAutoTo=null; }
 if(!SES) return;
 SES.idx++;
 if(SES.kind==="blitz"){ if(SES.blitzLeft<=0){ finishSession(); return; } SES.items.push(allItems(true)[Math.floor(Math.random()*240)]); renderQuestion(); return; }
 renderQuestion();
}
$("#btn-next").addEventListener("click", nextQuestion);
$("#btn-check-type").addEventListener("click", answerText);
$("#btn-quit").addEventListener("click", function(){
 if(!SES) return;
 askConfirm("কুইজ ছেড়ে যাবেন?", SES.kind==="quiz" ? "আপনার অগ্রগতি সেভ থাকবে — এই কুইজ আবার খুললেই Resume করে আগের জায়গা থেকে চালিয়ে যেতে পারবেন।" : "এই সেশনটি শেষ হয়ে যাবে এবং অগ্রগতি সেভ হবে না।", function(){
   if(SES && SES.kind==="quiz"){ S.resume={ quizId:SES.quizId, items:SES.items, idx:SES.idx, results:SES.results, mode:SES.mode }; save(); }
   stopAllTimers(); if(examInt){ clearInterval(examInt); examInt=null; } SES=null; showView("home");
 });
});
document.addEventListener("keydown", function(e){
 if(!SES || !$("#view-quiz").classList.contains("on")) return;
 var it=SES.items[SES.idx]; if(!it) return;
 if(e.key>="1" && e.key<="4" && it.type==="mcq" && !SES.answered){ answerMCQ(parseInt(e.key,10)-1); }
 else if(e.key==="Enter"){ if(SES.answered && $("#btn-next").style.display!=="none") nextQuestion(); else if(!SES.answered && it.type==="text" && document.activeElement!==$("#q-typein")) answerText(); }
});

/* ---------- finish & results ---------- */
function finishSession(){
 stopAllTimers(); if(examInt){ clearInterval(examInt); examInt=null; }
 if(!SES) return;
 var total = SES.kind==="blitz" ? SES.results.length : SES.items.length;
 var correct = SES.results.filter(function(r){ return r && r.ok; }).length;
 var pct = total>0 ? Math.round(correct/total*100) : 0;
 var xpGain;
 if(SES.kind==="blitz"){ xpGain=SES.xp; }
 else { xpGain = correct*10 + (pct===100?100:(pct>=80?50:0)); }
 S.xp += xpGain;
 if(SES.kind==="quiz" && SES.quizId){
