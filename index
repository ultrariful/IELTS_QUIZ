/* ---------- confetti ---------- */
function confettiBurst(){
 var cv=$("#confetti"), ctx=cv.getContext("2d");
 cv.width=window.innerWidth; cv.height=window.innerHeight; cv.style.display="block";
 var colors=["#d4af6a","#2bb896","#f59e0b","#34c759","#eef2fb"];
 var parts=[]; for(var i=0;i<140;i++){ parts.push({ x:Math.random()*cv.width, y:-20-Math.random()*cv.height*0.4, w:6+Math.random()*7, h:8+Math.random()*8, vy:2+Math.random()*3.5, vx:-1.5+Math.random()*3, rot:Math.random()*Math.PI, vr:-0.1+Math.random()*0.2, c:colors[i%colors.length] }); }
 var start=Date.now();
 (function frame(){
   ctx.clearRect(0,0,cv.width,cv.height);
   parts.forEach(function(p){ p.y+=p.vy; p.x+=p.vx; p.rot+=p.vr; ctx.save(); ctx.translate(p.x,p.y); ctx.rotate(p.rot); ctx.fillStyle=p.c; ctx.fillRect(-p.w/2,-p.h/2,p.w,p.h); ctx.restore(); });
   if(Date.now()-start<2600) requestAnimationFrame(frame); else { ctx.clearRect(0,0,cv.width,cv.height); cv.style.display="none"; }
 })();
}

/* ---------- special modes ---------- */
function startMock(){
 var pool=shuffleArr(allItems(true)).slice(0,20);
 startSession({ kind:"mock", title:"Mixed Mock Test", items:pool, mode:"exam" });
 toast("🎲 Mock শুরু! পরীক্ষার পরিবেশ — ব্যাখ্যা ফলাফলের পরে দেখা যাবে।");
}
function startBlitz(){
 var pool=allItems(true);
 startSession({ kind:"blitz", title:"Speed Blitz", items:[pool[Math.floor(Math.random()*pool.length)]], mode:"practice" });
}
function startDaily(){
 var t=todayStr(); var seed=0; for(var i=0;i<t.length;i++) seed=(seed*31+t.charCodeAt(i))|0;
 var rand=mulberry32(seed);
 var pool=[]; QUIZZES.forEach(function(q){ q.questions.forEach(function(_,i){ pool.push([q,i]); }); });
 pool=seedShuffle(pool,rand).slice(0,10);
 var items=pool.map(function(p){ var it=prepareItem(p[0],p[1],false); var order=[0,1,2,3];
   if(it.type==="mcq"){ var sh=seedShuffle(order,rand); var oldOpts=it.opts.slice(); it.opts=sh.map(function(j){ return oldOpts[j]; }); it.ans=sh.indexOf(it.ans); }
   return it; });
 startSession({ kind:"daily", title:"Daily Challenge", items:items, mode:"practice" });
}
function startMistakes(){
 var keys=Object.keys(S.mistakes);
 if(!keys.length){ toast("🎉 কোনো ভুল জমা নেই — দারুণ!"); return; }
 var items=keys.map(function(k){ var parts=k.split("#"); var q=quizById(parts[0]); return prepareItem(q, parseInt(parts[1],10), true); });
 items=shuffleArr(items);
 startSession({ kind:"mistakes", title:"My Mistakes", items:items, mode:"practice" });
}
function openSpecial(key){
 if(key==="daily"){ if(S.dailyDay===todayStr()){ askConfirm("আজকের চ্যালেঞ্জ সম্পন্ন ✓","আপনি আজকের Daily Challenge ইতিমধ্যে শেষ করেছেন। আবার প্র্যাক্টিস করতে চান? (ব্যাজ একবারই পাওয়া যায়)", function(){ startDaily(); }); } else startDaily(); }
 else if(key==="mock") startMock();
 else if(key==="blitz") startBlitz();
 else if(key==="flash") openFlash();
 else if(key==="mistakes") openMistakes();
